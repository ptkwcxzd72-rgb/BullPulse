ons and seeks civil penalties.","topic":"litigation"},{"point":"UGI recognized pre-tax non-cash impairment charges of $64 million in Fiscal 2026 related to the disposal of certain LPG distribution businesses.","quote":"In connection with these disposals, we recognized non-cash, pre-tax impairment charges of $ 64 , $ 3 and $ 62 during Fiscal 2026, Fiscal 2025 and Fiscal 2024, respectively, to reduce the carrying amount of long-lived assets included in the disposal groups to their estimated fair values.","topic":"impairment"}],"url":"https://www.sec.gov/Archives/edgar/data/884614/000088461426000070/ugi-20260930.htm"},"tone":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,0.002,null,-0.574,-0.312,-0.119,-0.7,-0.001,-0.348,null,null]}